# npm start loads .env when present. Never commit real credentials.
PUBLIC_DEMO=true
SEED_DEMO=true
HOST=127.0.0.1
PORT=3400
RUN_SCHEDULER=false
# Hosted HTTPS:
# COOKIE_SECURE=true
# Private single-operator mode:
# PUBLIC_DEMO=false
# DATABASE_PATH=data/sentinel.sqlite
# OPERATOR_PASSWORD=choose_a_unique_password_of_16_or_more_characters
# RUN_SCHEDULER=true
